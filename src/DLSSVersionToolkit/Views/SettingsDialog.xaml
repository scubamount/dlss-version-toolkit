<Window x:Class="DLSSVersionToolkit.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — DLSS Version Toolkit" Width="560" SizeToContent="Height"
        MinHeight="360" MinWidth="460" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <!-- v0.0.58: height sized by content (the v0.0.48 DPI-clip fix pattern) — a fixed 520px
         Height clipped the Save/Cancel row behind the bottom edge at 150%+ scaling.
         v0.76: grouped into cards, detected-path hint, per-path "folder not found" warnings, a
         status line for load/save errors, and "Restore previous" (snapshot taken on open). -->
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel1Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
        </Style>
        <Style x:Key="Warn" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Text" Value="⚠ Folder not found — auto-detect will be used instead."/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}"/>
            <TextBlock Text="Paths are optional — leave them empty and the toolkit finds them for you."
                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PATHS" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="NGX base folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NgxPathTextBox" Grid.Column="0" Margin="0,0,8,0"
                                     TextChanged="Path_TextChanged" AutomationProperties.Name="NGX base folder"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource DarkButtonStyle}"
                                    Click="BrowseNgxPath_Click" Padding="12,6" Margin="0"/>
                        </Grid>
                        <TextBlock x:Name="NgxDetectedText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="NgxWarnText" Style="{StaticResource Warn}" Margin="0,2,0,0"/>

                        <TextBlock Text="AnWave / nvidiaDlssGlom folder" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AnWavePathTextBox" Grid.Column="0" Margin="0,0,8,0"
                                     TextChanged="Path_TextChanged" AutomationProperties.Name="AnWave folder"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource DarkButtonStyle}"
                                    Click="BrowseAnWavePath_Click" Padding="12,6" Margin="0"/>
                        </Grid>
                        <TextBlock Text="Empty = the copy Setup AnWave installs (or one unpacked in Downloads)."
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="AnWaveWarnText" Style="{StaticResource Warn}" Margin="0,2,0,0"/>

                        <TextBlock Text="Streamline SDK folder" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StreamlinePathTextBox" Grid.Column="0" Margin="0,0,8,0"
                                     TextChanged="Path_TextChanged" AutomationProperties.Name="Streamline SDK folder"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource DarkButtonStyle}"
                                    Click="BrowseStreamlinePath_Click" Padding="12,6" Margin="0"/>
                        </Grid>
                        <TextBlock Text="Empty = the x64 SDK that Update All downloads."
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="StreamlineWarnText" Style="{StaticResource Warn}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized to tray"/>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray instead of closing"/>
                        <CheckBox x:Name="AutoScanCheckBox" Content="Re-scan in the background every 4 hours"/>
                        <CheckBox x:Name="NotifyOnNewVersionCheckBox" Content="Notify me when a new DLSS version is available"/>
                        <CheckBox x:Name="CheckForAppUpdatesCheckBox" Content="Check for toolkit updates on launch"/>
                    </StackPanel>
                </Border>

                <!-- Update sources (v0.72). -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="UPDATE SOURCES" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="IncludePreReleaseCheckBox" Content="Include pre-release (staging) channel"/>
                        <TextBlock Text="Shows NVIDIA's staging builds, which run ahead of the ones the driver installs on its own. Labelled &quot;OTA pre-release&quot; and only shown when newer."
                                   Style="{StaticResource Hint}" Margin="24,0,0,8"/>

                        <CheckBox x:Name="AllowOtaDownloadsCheckBox" Content="Allow downloads from NVIDIA's OTA channel"/>
                        <TextBlock Text="Fetches component files from NVIDIA's update CDN instead of GitHub only. Every file is checked against its published SHA-256 and NVIDIA's Authenticode signature before it is installed."
                                   Style="{StaticResource Hint}" Margin="24,0,0,8"/>

                        <CheckBox x:Name="OtaRedistributionAcceptedCheckBox"
                                  Content="I accept responsibility for fetching NVIDIA components"
                                  Margin="24,4,0,4"/>
                        <TextBlock Text="Required before any OTA download runs. These are NVIDIA-copyrighted files served from an endpoint NVIDIA does not publicly document; redistribution terms are unresolved. Until this is checked the toolkit only reports which versions exist and downloads nothing."
                                   Style="{StaticResource Hint}" Margin="44,0,0,4"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="by Scubamount" FontSize="10" Foreground="{StaticResource Text3Brush}"
                           HorizontalAlignment="Right" Margin="0,4,0,0" FontStyle="Italic"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap"
                   FontSize="11" Foreground="{StaticResource AmberBrush}" Margin="0,10,0,0"/>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RestorePreviousButton" Grid.Column="0" Content="↶  Restore previous"
                    Style="{StaticResource DarkButtonStyle}" Margin="0" IsEnabled="False"
                    Click="RestorePrevious_Click"
                    ToolTip="Loads the settings as they were when this window was opened. Nothing is written until you click Save."/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                        Click="Save_Click" MinWidth="90" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Cancel" Style="{StaticResource DarkButtonStyle}"
                        Click="Cancel_Click" MinWidth="90" Margin="0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

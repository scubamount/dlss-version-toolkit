<Window x:Class="DLSSVersionToolkit.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="480" SizeToContent="Height"
        MinHeight="320" MinWidth="420" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBackgroundBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <!-- v0.0.58: height sized by content (the v0.0.48 DPI-clip fix pattern) — a fixed 520px
         Height clipped the Save/Cancel row behind the bottom edge at 150%+ scaling. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource NvidiaGreenBrush}" Margin="0,0,0,16"/>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Paths Section -->
                <TextBlock Text="Paths" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                <!-- NGX Path -->
                <Label Content="NGX Base Path:"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NgxPathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource DarkButtonStyle}"
                            Click="BrowseNgxPath_Click" Padding="12,6"/>
                </Grid>

                <!-- AnWave Path -->
                <Label Content="AnWave Path (optional):"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AnWavePathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource DarkButtonStyle}"
                            Click="BrowseAnWavePath_Click" Padding="12,6"/>
                </Grid>
                <TextBlock Text="Leave empty for auto-detect" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,12"/>

                <!-- Streamline Path -->
                <Label Content="Streamline SDK Path (optional):"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StreamlinePathTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource DarkButtonStyle}"
                            Click="BrowseStreamlinePath_Click" Padding="12,6"/>
                </Grid>
                <TextBlock Text="Leave empty for auto-detect" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,16"/>

                <!-- Options Section -->
                <TextBlock Text="Options" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                <CheckBox x:Name="StartMinimizedCheckBox" Content="Start minimized to tray" Margin="0,4"/>
                <CheckBox x:Name="AutoScanCheckBox" Content="Enable periodic background scans (every 4 hours)" Margin="0,4"/>
                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray instead of closing" Margin="0,4"/>
                <CheckBox x:Name="NotifyOnNewVersionCheckBox" Content="Show notifications for new DLSS versions" Margin="0,4"/>
                <CheckBox x:Name="CheckForAppUpdatesCheckBox" Content="Check for app updates on launch" Margin="0,4"/>

                <!-- Watermark -->
                <TextBlock Text="by Scubamount" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" Margin="0,20,0,0" FontStyle="Italic"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Style="{StaticResource DarkButtonStyle}"
                    Click="Save_Click" Width="80" Margin="0,0,8,0"/>
            <Button Content="Cancel" Style="{StaticResource DarkButtonStyle}"
                    Click="Cancel_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
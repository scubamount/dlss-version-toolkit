<Window x:Class="DLSSVersionToolkit.Views.UpdateAllPreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update All"
        SizeToContent="Height" Width="560"
        MinWidth="460" MinHeight="240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource Text1Brush}">
    <!-- Sized by content inside a resizable frame. Fixed-size dialogs clipped at high DPI in
         v0.0.48 (SettingsDialog / BackupsDialog were both NoResize), so neither is used here. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Update All" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Text1Brush}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource Text2Brush}"
                       Text="Applies the whitelist, unlocks unsupported games, pushes your selected presets to every game profile, downloads and syncs the latest Streamline and DLSS SDKs, then updates AnWave."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12"
                Background="{StaticResource Panel2Brush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
            <StackPanel>
                <CheckBox x:Name="ImportCheckBox"
                          Content="Also import local DLLs"
                          Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold"
                          Checked="ImportCheckBox_Changed" Unchecked="ImportCheckBox_Changed"/>
                <TextBlock Margin="20,4,0,0" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource Text3Brush}"
                           Text="For DLLs with no official NVIDIA release — such as the DLSS 4.5 Ray Reconstruction nvngx_dlssd.dll pulled from a game build. Runs after the SDK sync so your files win."/>

                <Grid x:Name="FolderRow" Margin="20,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderTextBox" Grid.Column="0"
                             IsReadOnly="True" Padding="6,4" FontSize="11"
                             Background="{StaticResource Panel1Brush}"
                             Foreground="{StaticResource Text2Brush}"
                             BorderBrush="{StaticResource HairlineBrush}"
                             TextWrapping="NoWrap"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,4"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="Browse_Click"/>
                </Grid>

                <TextBlock x:Name="ImportWarning" Margin="20,6,0,0" TextWrapping="Wrap"
                           FontSize="11" Visibility="Collapsed"
                           Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource Text3Brush}"
                   Text="Existing files are backed up before anything is overwritten. Per-step results appear in the run report on the dashboard."/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource DarkButtonStyle}" Padding="16,6"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Run Update All" Margin="8,0,0,0" Padding="16,6"
                    Style="{StaticResource SolidGreenButtonStyle}"
                    IsDefault="True" Click="Run_Click"/>
        </StackPanel>
    </Grid>
</Window>

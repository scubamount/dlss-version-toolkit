<Application x:Class="DLSSVersionToolkit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DLSSVersionToolkit"
             xmlns:converters="clr-namespace:DLSSVersionToolkit.Converters"
             Startup="Application_Startup"
             Exit="Application_Exit">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:VersionToColorConverter x:Key="VersionToColorConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <!-- Color Resources -->
            <Color x:Key="NvidiaGreenColor">#76B900</Color>
            <Color x:Key="DarkBackgroundColor">#1E1E1E</Color>
            <Color x:Key="SurfaceColor">#2D2D2D</Color>
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#AAAAAA</Color>
            <Color x:Key="ErrorColor">#F44336</Color>
            <Color x:Key="WarningColor">#FFC107</Color>
            <Color x:Key="SuccessColor">#4CAF50</Color>
            <Color x:Key="BorderColor">#3D3D3D</Color>

            <SolidColorBrush x:Key="NvidiaGreenBrush" Color="{StaticResource NvidiaGreenColor}"/>
            <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

            <!-- v0.0.29 redesign tokens (NVIDIA-leaning sidebar dashboard).
                 Additive: existing keys above are preserved so Settings/other windows keep working. -->
            <Color x:Key="CanvasColor">#000000</Color>          <!-- true-black canvas -->
            <Color x:Key="Panel1Color">#0E0E0E</Color>          <!-- sidebar / panels -->
            <Color x:Key="Panel2Color">#171717</Color>          <!-- elevated cards / table header -->
            <Color x:Key="Panel3Color">#1F1F1F</Color>          <!-- hover -->
            <Color x:Key="HairlineColor">#2A2A2A</Color>        <!-- subtle border -->
            <Color x:Key="HairlineStrongColor">#3A3A3A</Color>
            <Color x:Key="Text1Color">#F2F2F2</Color>
            <Color x:Key="Text2Color">#A7A7A7</Color>
            <Color x:Key="Text3Color">#757575</Color>
            <Color x:Key="GreenDimColor">#3F8500</Color>
            <Color x:Key="AmberColor">#EF9100</Color>

            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
            <SolidColorBrush x:Key="Panel1Brush" Color="{StaticResource Panel1Color}"/>
            <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}"/>
            <SolidColorBrush x:Key="Panel3Brush" Color="{StaticResource Panel3Color}"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}"/>
            <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource Text1Color}"/>
            <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
            <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}"/>
            <SolidColorBrush x:Key="GreenDimBrush" Color="{StaticResource GreenDimColor}"/>
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>

            <!-- Sidebar nav button: flat, left-accent on hover; IsActive via Tag="active" -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="2,0,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="active">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource NvidiaGreenBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary action: transparent w/ green border, fills green on hover (NVIDIA pattern) -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource NvidiaGreenBrush}" BorderThickness="2"
                                    CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource NvidiaGreenBrush}"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Solid green action ("Apply to all games") -->
            <Style x:Key="SolidGreenButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="{StaticResource GreenDimBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource NvidiaGreenBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource NvidiaGreenBrush}"/>
                                    <Setter Property="Foreground" Value="#000000"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Button Style -->
            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource NvidiaGreenBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource NvidiaGreenBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TextBox Style -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- CheckBox Style -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>

            <!-- Menu Style -->
            <Style TargetType="Menu">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

	<!-- Override system highlight colors used by default MenuItem template -->
	<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3D3D3D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#3D3D3D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D2D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFFFFF"/>

	<!-- MenuItem Style -->
	<Style TargetType="MenuItem">
		<Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontFamily" Value="Segoe UI"/>
		<Style.Triggers>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter Property="Background" Value="#3D3D3D"/>
				<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>

            <!-- ContextMenu Style (used for Menu dropdowns) -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0,4"/>
            </Style>
	<!-- Separator Style -->
	<Style TargetType="Separator">
		<Setter Property="Background" Value="#3D3D3D"/>
		<Setter Property="Height" Value="1"/>
		<Setter Property="Margin" Value="4,2"/>
	</Style>


            <!-- Label Style -->
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Padding" Value="0,0,0,4"/>
            </Style>

            <!-- Window Style -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource DarkBackgroundBrush}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DLSSVersionToolkit.Core\DLSSVersionToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libs (e.g. nvapi64 interop shims, WPF natives) must be packed into the
         single-file bundle and extracted at runtime. Excluding them was a latent cause of
         "missing DLL" load failures on machines without the libs sitting next to the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>DLSSVersionToolkit</AssemblyName>
    <AssemblyVersion>0.0.35.2</AssemblyVersion>
    <FileVersion>0.0.35.2</FileVersion>
    <Version>0.0.35.2</Version>
    <Authors>scubamount</Authors>
    <Product>DLSS Version Toolkit</Product>
    <Description>WPF GUI for checking and upgrading NVIDIA DLSS versions</Description>
    <Copyright>Copyright 2026 scubamount</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allow managed catch blocks to handle corrupted-state exceptions (AccessViolation,
         SEHException) raised by native P/Invoke into nvapi64.dll. Without this a native
         fault inside NVIDIA.Initialize() escapes our try/catch and kills the process. -->
    <LegacyCorruptedStateExceptionsPolicy>true</LegacyCorruptedStateExceptionsPolicy>
  </PropertyGroup>

</Project>

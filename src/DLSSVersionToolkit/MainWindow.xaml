<Window x:Class="DLSSVersionToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DLSSVersionToolkit"
        xmlns:vm="clr-namespace:DLSSVersionToolkit.ViewModels"
        xmlns:converters="clr-namespace:DLSSVersionToolkit.Converters"
        Title="DLSS Version Toolkit — by scubamount" Height="880" Width="1320"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">
    <!-- Size is clamped to the ACTUAL monitor's work area in MainWindow.xaml.cs (FitToWorkArea,
         called on SourceInitialized and DpiChanged). MaxWidth/MaxHeight are deliberately not
         bound here: x:Static SystemParameters.MaximizedPrimaryScreen* reads the PRIMARY monitor
         once at load, which was wrong on multi-monitor setups and never updated across a DPI
         change. The values above are the preferred/floor sizes; code-behind lowers them when
         the display cannot afford them. -->
    <Window.Resources>
        <converters:DlssPresetDescriptionConverter x:Key="DlssPresetDescriptionConverter"/>
        <converters:DlssPresetDescriptionConverter x:Key="DlssPresetRrDescriptionConverter" Mode="Rr"/>
        <converters:DlssPresetDescriptionConverter x:Key="DlssPresetFgDescriptionConverter" Mode="Fg"/>
        <converters:DlssPresetShortLabelConverter x:Key="DlssPresetShortLabelConverter"/>
        <converters:DlssgModeLabelConverter x:Key="DlssgModeLabelConverter"/>
        <converters:FrameGenMultiplierLabelConverter x:Key="FrameGenMultiplierLabelConverter"/>

        <!-- DataGrid cell that turns green for the newest DLSS build -->
        <Style x:Key="NewestCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNewestDLSS}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reusable column-cell text style (mono) -->
        <Style x:Key="MonoCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1Brush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Sidebar group label -->
        <Style x:Key="NavGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="18,14,18,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- branded header -->
            <RowDefinition Height="*"/>      <!-- sidebar + main -->
            <RowDefinition Height="28"/>     <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===== BRANDED HEADER (maker attribution) ===== -->
        <Border Grid.Row="0" Background="#050505" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⬢ DLSS TOOLKIT" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource NvidiaGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="by scubamount" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <!-- right: app update pill + version + indicator toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App self-update pill: collapsed unless a newer release exists -->
                    <Button Command="{Binding ApplyAppUpdateCommand}" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,0"
                            IsEnabled="{Binding IsApplyingAppUpdate, Converter={StaticResource InverseBoolConverter}}"
                            Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="A new version of DLSS Version Toolkit is available. Click to download and install.">
                        <Border CornerRadius="2" Padding="10,4" BorderThickness="1"
                                BorderBrush="{StaticResource AmberBrush}" Background="Transparent">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}">
                                <Run Text="⬆ v"/><Run Text="{Binding AppUpdateVersion, Mode=OneWay}"/><Run Text=" available"/>
                            </TextBlock>
                        </Border>
                    </Button>
                    <!-- Indicator on/off signal dot (green = On, grey = Off) -->
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Text3Brush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDlssIndicatorEnabled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource NvidiaGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding DlssIndicatorStatus}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="Toggle the on-screen DLSS overlay (appears bottom-left of supported games after a full restart).">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDlssIndicatorEnabled}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="Toggle Indicator" Style="{StaticResource DarkButtonStyle}" Padding="10,4" FontSize="11"
                            Command="{Binding ToggleDlssIndicatorCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BODY: SIDEBAR + MAIN ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource Panel1Brush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- status card pinned to bottom -->
                    <Border DockPanel.Dock="Bottom" Margin="14,10" Padding="10"
                            Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScanStatus}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource Text2Brush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnWaveInstalled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="{StaticResource Text2Brush}" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="AnWave: "/><Run Text="{Binding AnWaveDllVersion, Mode=OneWay, TargetNullValue='not set', FallbackValue='not set'}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <!-- amber by default (not applied / unknown); green once detected applied -->
                                            <Setter Property="Fill" Value="{StaticResource AmberBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWhitelistApplied}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="{StaticResource Text2Brush}" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="Whitelist: "/><Run Text="{Binding WhitelistStatus, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- nav items — scrollable so the HELP group stays reachable even when the
                         window is short (the status card stays pinned to the bottom) -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="OVERVIEW" Style="{StaticResource NavGroupLabel}"/>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="active" Command="{Binding ShowDashboardCommand}" Content="▦   Dashboard"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ScanCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="⟲   Rescan"/>

                        <TextBlock Text="CONFIGURE" Style="{StaticResource NavGroupLabel}"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding OpenSettingsCommand}" Content="⚙   Settings"/>
                        <Button Command="{Binding SetupAnWaveCommand}"
                                IsEnabled="{Binding IsSettingUpAnWave, Converter={StaticResource InverseBoolConverter}}" Content="⬡   Setup AnWave">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <!-- Dim + annotate when Update All / a prior run already installed AnWave -->
                                    <Setter Property="ToolTip" Value="Install AnWave (downloads nvidiaDlssGlom + latest DLSS DLLs)."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnWaveInstalled}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                            <Setter Property="ToolTip" Value="AnWave is already installed — Update All keeps it in sync. Click only to reinstall."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="ADVANCED" Style="{StaticResource NavGroupLabel}"
                                   ToolTip="Manual steps — Update All runs all of these for you in the right order."/>
                        <TextBlock Text="Update All runs these for you" Foreground="{StaticResource Text3Brush}"
                                   FontSize="10" Margin="16,0,12,4" TextWrapping="Wrap"/>
                        <Button Command="{Binding ApplyWhitelistCommand}" Content="✓   Apply Whitelist">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Setter Property="ToolTip" Value="Remove NVIDIA App's DLSS4 override restrictions and restart NVIDIA services."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWhitelistApplied}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                            <Setter Property="ToolTip" Value="Whitelist already applied — Update All maintains it. Click only to re-apply."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding UnlockUnsupportedGamesCommand}"
                                Content="🔓   Unlock Unsupported Games"
                                ToolTip="For games the NVIDIA App shows as &quot;not supported&quot; (e.g. Star Citizen): marks them as override-capable so DLSS override options appear. Backs up ApplicationStorage.json first. Update All runs this for you — click only to re-apply after the NVIDIA App updates its library."/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ImportLocalDllsCommand}"
                                Content="📥   Import Local DLLs"
                                ToolTip="Apply nvngx_*.dll files you already have on disk — for builds with no official NVIDIA release, such as the DLSS 4.5 Ray Reconstruction nvngx_dlssd.dll. Each DLL's version is read from the file itself and written into the NGX model tree the driver loads. Existing files are backed up first. Uses a community-derived layout NVIDIA does not document."/>
                        <CheckBox Content="Import to Staging tree"
                                  IsChecked="{Binding ImportToStaging}"
                                  Margin="14,4,0,6" Foreground="#A0A0A0" FontSize="11"
                                  ToolTip="Staging is what the reference tool writes to (its &quot;Staging NGX Directory&quot; option). Uncheck to write the production models tree instead."/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding DownloadLatestCommand}" Content="⤓   Download DLSS SDK"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding DownloadStreamlineCommand}" Content="⤓   Download Streamline"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding SyncFromDlssSdkCommand}" Content="⟳   Sync NGX from DLSS"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding SyncFromAnWaveCommand}" Content="⟳   Sync NGX from AnWave"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding IndexProfilesCommand}"
                                IsEnabled="{Binding IsIndexingProfiles, Converter={StaticResource InverseBoolConverter}}"
                                Content="⚡   Index Game Profiles"
                                ToolTip="Scan the NVIDIA driver profile database once and remember which profiles belong to installed games. Makes 'Apply to all games' and 'Update All' significantly faster. Auto-refreshes when the driver changes."/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ExportCommand}" Content="⤴   Export Report"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding OpenBackupsCommand}" Content="🗄   NGX Backups"/>

                        <TextBlock Text="HELP" Style="{StaticResource NavGroupLabel}"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ShowQuickGuideCommand}" Content="?   Quick Guide"/>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}">
                <StackPanel Margin="0,0,0,20">
                    <!-- Page head -->
                    <Grid Margin="28,20,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text1Brush}"/>
                            <TextBlock Text="{Binding VersionStatusMessage, FallbackValue='Scan to check your DLSS versions and presets.'}"
                                       FontSize="13" Foreground="{StaticResource Text3Brush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Quick guide card (first run, or via HELP > Quick Guide) -->
                    <Border Margin="28,18,28,0" Padding="18,14"
                            Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource NvidiaGreenBrush}" BorderThickness="1"
                            Visibility="{Binding IsQuickGuideVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="HOW TO USE THIS APP" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource NvidiaGreenBrush}" Margin="0,0,0,8"/>
                                <TextBlock Foreground="{StaticResource Text1Brush}" FontSize="13" TextWrapping="Wrap" LineHeight="22">
                                    <Run Text="1." FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}"/>
                                    <Run Text="  Pick your preferred "/><Run Text="Override Preset" FontWeight="SemiBold"/><Run Text=" below (e.g. L)."/>
                                    <LineBreak/>
                                    <Run Text="2." FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}"/>
                                    <Run Text="  Click "/><Run Text="Update All" FontWeight="SemiBold"/><Run Text=" — it handles everything: whitelist, latest DLSS download, NGX sync, and applying your preset to every game."/>
                                    <LineBreak/>
                                    <Run Text="3." FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}"/>
                                    <Run Text="  Fully restart your game"/><Run Text=" (not just to the menu) for changes to take effect."/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource Text3Brush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Tip: turn on the DLSS Indicator (top right) to verify in-game — the overlay appears in the bottom-left corner. Items under ADVANCED are manual steps that Update All already runs for you."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Got it" Style="{StaticResource SolidGreenButtonStyle}"
                                    VerticalAlignment="Top" Margin="16,0,0,0"
                                    Command="{Binding DismissQuickGuideCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Hero version strip -->
                    <Border Margin="28,18,28,0" Padding="20,18" Background="{StaticResource Panel1Brush}"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,1,1,1">
                        <Border.Resources>
                            <Style TargetType="TextBlock" x:Key="HeroKey">
                                <Setter Property="Foreground" Value="{StaticResource Text3Brush}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </Border.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- green left accent bar -->
                            <Border Grid.Column="0" Width="2" Background="{StaticResource NvidiaGreenBrush}" Margin="0,0,18,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CURRENT NGX" Style="{StaticResource HeroKey}"/>
                                <TextBlock Text="{Binding CurrentDlssVersion, FallbackValue='—'}" FontFamily="Consolas"
                                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource NvidiaGreenBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" Foreground="{StaticResource Text3Brush}" FontSize="18"
                                       VerticalAlignment="Center" Margin="24,0"/>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="LATEST AVAILABLE" Style="{StaticResource HeroKey}"/>
                                <TextBlock Text="{Binding AvailableDlssVersion, FallbackValue='—'}" FontFamily="Consolas"
                                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text1Brush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <!-- Streamline SDK version (v0.0.38). Sits in the flexible column so the
                                 status pill stays pinned right. NGX folders can't carry a Streamline
                                 version (no sl.common.dll there) — this shows the scanned SDK or the
                                 cached download instead of the old always-N/A grid column. -->
                            <StackPanel Grid.Column="4" Margin="24,0,0,0" HorizontalAlignment="Left"
                                        ToolTip="Streamline SDK version detected on this machine (scanned SDK folder, or the toolkit's cached download). Streamline ships the full NGX DLL set that Update All syncs.">
                                <TextBlock Text="STREAMLINE SDK" Style="{StaticResource HeroKey}"/>
                                <TextBlock Text="{Binding StreamlineVersion, FallbackValue='—'}" FontFamily="Consolas"
                                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text1Brush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <!-- status pill -->
                            <Border Grid.Column="5" VerticalAlignment="Center" CornerRadius="2" Padding="10,4"
                                    BorderThickness="1" BorderBrush="{StaticResource NvidiaGreenBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="UP TO DATE"/>
                                            <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                    <Setter Property="Text" Value="UPDATE AVAILABLE"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Primary action row -->
                    <Grid Margin="28,16,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Update All -->
                        <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"
                                Command="{Binding OneClickUpdateAllCommand}"
                                ToolTip="One click: applies the whitelist, pushes the selected presets to every game, downloads the latest DLSS SDK and syncs it to NGX, and sets up AnWave.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳  Update All" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Override preset pickers: SR / RR / FG, each independent -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- DLSS-SR (Super Resolution) — the main upscaling preset -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="DLSS-SR PRESET" Foreground="{StaticResource Text3Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                                               ToolTip="DLSS Super Resolution render preset (the main upscaler). Recommended: L."/>
                                    <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}"
                                              MinWidth="210" FontSize="12"
                                              Background="{StaticResource Panel2Brush}" Foreground="{StaticResource NvidiaGreenBrush}"
                                              BorderBrush="{StaticResource HairlineStrongBrush}" Padding="8,5" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsApplyingPreset, Converter={StaticResource InverseBoolConverter}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource DlssPresetDescriptionConverter}}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- DLSS-RR (Ray Reconstruction) — independent preset; recommended E -->
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="DLSS-RR PRESET" Foreground="{StaticResource Text3Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                                               ToolTip="DLSS Ray Reconstruction (denoiser) render preset. Recommended: E (best quality)."/>
                                    <ComboBox ItemsSource="{Binding AvailableRrPresets}" SelectedItem="{Binding SelectedRrPreset}"
                                              MinWidth="120" FontSize="12"
                                              Background="{StaticResource Panel2Brush}" Foreground="{StaticResource NvidiaGreenBrush}"
                                              BorderBrush="{StaticResource HairlineStrongBrush}" Padding="8,5" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsApplyingPreset, Converter={StaticResource InverseBoolConverter}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource DlssPresetRrDescriptionConverter}}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- DLSS-FG (Frame Generation) — independent preset; recommended B -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DLSS-FG PRESET" Foreground="{StaticResource Text3Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                                               ToolTip="DLSS Frame Generation render preset. Recommended: B (higher quality than A)."/>
                                    <ComboBox ItemsSource="{Binding AvailableFgPresets}" SelectedItem="{Binding SelectedFgPreset}"
                                              MinWidth="120" FontSize="12"
                                              Background="{StaticResource Panel2Brush}" Foreground="{StaticResource NvidiaGreenBrush}"
                                              BorderBrush="{StaticResource HairlineStrongBrush}" Padding="8,5" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsApplyingPreset, Converter={StaticResource InverseBoolConverter}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource DlssPresetFgDescriptionConverter}}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- DLSS-FG generator MODE + MULTIPLIER (Fixed/Dynamic + 2x..6x).
                                 Separate from the FG preset above; these are the knobs that the
                                 NVIDIA App's "Dynamic, up to Nx, at max refresh rate" sets. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- FG generator mode -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="DLSS-FG MODE" Foreground="{StaticResource Text3Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                                               ToolTip="Frame Generation mode. Dynamic adapts the multiplier to hit the target FPS (recommended); Fixed uses a constant multiplier. 'Don't change' leaves the driver/NVIDIA App value untouched."/>
                                    <ComboBox ItemsSource="{Binding AvailableFgModes}" SelectedItem="{Binding SelectedFgMode}"
                                              MinWidth="140" FontSize="12"
                                              Background="{StaticResource Panel2Brush}" Foreground="{StaticResource NvidiaGreenBrush}"
                                              BorderBrush="{StaticResource HairlineStrongBrush}" Padding="8,5" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsApplyingPreset, Converter={StaticResource InverseBoolConverter}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource DlssgModeLabelConverter}}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- FG multiplier (Nx) -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DLSS-FG MULTIPLIER" Foreground="{StaticResource Text3Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"
                                               ToolTip="Frame multiplier (the 'Nx'). In Fixed mode this is the constant multiplier; in Dynamic mode it's the cap. Ignored when mode is Off/Auto/Don't change."/>
                                    <ComboBox ItemsSource="{Binding AvailableFgMultipliers}" SelectedItem="{Binding SelectedFgMultiplier}"
                                              MinWidth="100" FontSize="12"
                                              Background="{StaticResource Panel2Brush}" Foreground="{StaticResource NvidiaGreenBrush}"
                                              BorderBrush="{StaticResource HairlineStrongBrush}" Padding="8,5" VerticalAlignment="Center"
                                              IsEnabled="{Binding FgMultiplierEnabled}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FrameGenMultiplierLabelConverter}}" FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Button Content="Apply to all games" Style="{StaticResource SolidGreenButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding ApplyPresetCommand}"
                                    IsEnabled="{Binding IsApplyingPreset, Converter={StaticResource InverseBoolConverter}}"
                                    ToolTip="Enables the DLSS overrides (&quot;Custom&quot;) and applies the SR, RR and FG presets to every game profile. Takes a few seconds; fully restart the game afterward."/>
                        </StackPanel>
                    </Grid>

                    <!-- Current preset status line -->
                    <TextBlock Margin="28,8,28,0" FontSize="11" Foreground="{StaticResource Text3Brush}"
                               Text="{Binding CurrentPresetStatus, FallbackValue=''}"/>

                    <!-- Installed Versions -->
                    <TextBlock Text="INSTALLED VERSIONS" Margin="28,22,28,8" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Text2Brush}"/>

                    <Border Margin="28,0,28,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="2">
                        <DataGrid ItemsSource="{Binding Versions}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  Background="{StaticResource CanvasBrush}" Foreground="{StaticResource Text1Brush}"
                                  BorderThickness="0"
                                  RowBackground="{StaticResource CanvasBrush}" AlternatingRowBackground="{StaticResource Panel1Brush}"
                                  HorizontalGridLinesBrush="{StaticResource HairlineBrush}"
                                  VerticalGridLinesBrush="{StaticResource HairlineBrush}"
                                  RowHeight="32" ColumnHeaderHeight="34">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source" Binding="{Binding DisplaySource}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="10,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Build ID" Binding="{Binding BuildID}" Width="120" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="DLSS" Binding="{Binding DLSS}" Width="110" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="Frame Gen" Binding="{Binding FrameGen}" Width="110" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="DLSSD" Binding="{Binding DLSSD}" Width="110" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="DeepDVC" Binding="{Binding DeepDVC}" Width="110" ElementStyle="{StaticResource MonoCellStyle}"/>
                                <DataGridTextColumn Header="Streamline" Binding="{Binding Streamline}" Width="*" ElementStyle="{StaticResource MonoCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Games section (v0.0.47): the user's installed-game profiles, disclosed
                         as a cached index. The subject is the game, not the plumbing. -->
                    <TextBlock Text="YOUR GAMES" Margin="28,24,28,8" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Text2Brush}"/>
                    <Border Margin="28,0,28,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="2">
                        <StackPanel>
                            <TextBlock Margin="12,8,12,0" FontSize="11" Foreground="{StaticResource Text3Brush}"
                                       Text="{Binding GamesFreshness}" TextWrapping="Wrap"/>
                            <ItemsControl Margin="12,8" ItemsSource="{Binding GameProfiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,6" Padding="10,4" CornerRadius="2"
                                                Background="{StaticResource Panel2Brush}"
                                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource Text1Brush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Unnamed driver profiles are disclosed as one line rather than ~40
                                 hex chips that bury the real game titles. They ARE still indexed
                                 and still receive the preset; this is display-only. -->
                            <TextBlock Margin="12,0,12,10" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text3Brush}"
                                       Visibility="{Binding HasUnnamedGames, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="+"/><Run Text="{Binding UnnamedGameCount, Mode=OneWay}"/><Run Text=" unnamed driver profile(s) — indexed and updated, no title reported by the driver."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Last Run report (v0.0.47): the steps of the most recent Update All run,
                         persisted to disk so success evidence outlives the dialog. -->
                    <TextBlock Text="LAST RUN" Margin="28,24,28,8" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Text2Brush}"
                               Visibility="{Binding HasRunSteps, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Margin="28,0,28,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="2"
                            Visibility="{Binding HasRunSteps, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl Margin="12" ItemsSource="{Binding RunSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Width="18" FontSize="11" FontWeight="Bold"
                                                   Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="warn">
                                                            <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="fail">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text1Brush}" Width="90"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Text2Brush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel1Brush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- left: scan status + last scan -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanStatus}" Value="Scanning...">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanStatus}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUpdatingAll}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource NvidiaGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsApplyingPreset}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource NvidiaGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource Text2Brush}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Last: " Foreground="{StaticResource Text3Brush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding LastScanTime, Mode=OneWay}" Foreground="{StaticResource Text2Brush}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- center: progress during update OR preset apply -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdatingAll}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsApplyingPreset}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar Width="120" Height="6"
                                 IsIndeterminate="{Binding ApplyProgressIndeterminate}"
                                 Value="{Binding ApplyProgressValue}" Maximum="100"
                                 Foreground="{StaticResource NvidiaGreenBrush}" Background="{StaticResource Panel3Brush}"/>
                    <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource NvidiaGreenBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- right: warning / error message -->
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}"
                           FontSize="10" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="DLSSVersionToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DLSSVersionToolkit"
        xmlns:vm="clr-namespace:DLSSVersionToolkit.ViewModels"
        mc:Ignorable="d"
        Title="DLSS Version Toolkit" Height="680" Width="960"
        MinHeight="580" MinWidth="880"
        Background="{StaticResource DarkBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NewestCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNewestDLSS}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <TextBlock Grid.Column="0" Text="DLSS Toolkit" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource NvidiaGreenBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Scan -->
                <Button Grid.Column="1" Content="Scan" Style="{StaticResource DarkButtonStyle}"
                        Command="{Binding ScanCommand}" Padding="16,6" Margin="0,0,6,0"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>

                <!-- Update All — main action button -->
                <Button Grid.Column="2" Command="{Binding OneClickUpdateAllCommand}" Padding="20,6" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                            <Setter Property="Background" Value="#2D7D2D"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUpdatingAll}" Value="True">
                                    <Setter Property="Background" Value="#2D7D2D"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Update All" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text=" | " Foreground="#AAAAAA" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} → {1}">
                                        <Binding Path="CurrentDlssVersion" FallbackValue="—"/>
                                        <Binding Path="AvailableDlssVersion" FallbackValue="—"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!-- Advanced dropdown -->
                <Menu Grid.Column="3" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <MenuItem Header="Advanced ▾" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextSecondaryBrush}" Padding="12,6" FontSize="11">
                        <MenuItem Header="Sync From Streamline SDK" Command="{Binding SyncFromStreamlineCommand}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <MenuItem Header="Sync From AnWave" Command="{Binding SyncFromAnWaveCommand}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <MenuItem Header="Download DLSS SDK" Command="{Binding DownloadLatestCommand}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Separator/>
                        <MenuItem Header="Apply to AnWave (detected)" Command="{Binding ApplyToAnWaveCommand}" Foreground="{StaticResource TextPrimaryBrush}" IsEnabled="{Binding IsAnWaveDetected}"/>
                        <MenuItem Header="Auto-Apply DLSS" Command="{Binding AutoApplyToAnWaveCommand}" Foreground="{StaticResource TextPrimaryBrush}" IsEnabled="{Binding IsAnWaveInstalled}"/>
                        <Separator/>
                        <MenuItem Header="Setup AnWave" Command="{Binding SetupAnWaveCommand}" Foreground="{StaticResource TextPrimaryBrush}" IsEnabled="{Binding IsSettingUpAnWave, Converter={StaticResource InverseBoolConverter}}"/>
                    </MenuItem>
                </Menu>

                <!-- Settings -->
                <Button Grid.Column="5" Content="Settings" Style="{StaticResource DarkButtonStyle}"
                        Command="{Binding OpenSettingsCommand}" Padding="12,6" Margin="6,0,0,0"/>

                <!-- Export -->
                <Button Grid.Column="6" Content="Export" Style="{StaticResource DarkButtonStyle}"
                        Command="{Binding ExportCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Version Banner -->
        <Border Grid.Row="1" Background="#1A3A1A" BorderBrush="#2D5A2D" BorderThickness="0,0,0,1" Padding="16,10" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Current NGX: " Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDlssVersion, FallbackValue='—'}" Foreground="{StaticResource NvidiaGreenBrush}"
                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="   |   Available: " Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding AvailableDlssVersion, FallbackValue='—'}" Foreground="#4CAF50"
                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="   |   " Foreground="#555555" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding VersionStatusMessage, FallbackValue=''}" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- AnWave status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#888888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnWaveInstalled}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="AnWave: "/>
                        <Run Text="{Binding AnWaveDllVersion, Mode=OneWay, TargetNullValue='not set', FallbackValue='not set'}"/>
                    </TextBlock>
                    <TextBlock Text="|" Foreground="#555555" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsAnWaveInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Setup" Style="{StaticResource DarkButtonStyle}" Padding="8,3" FontSize="10"
                            Command="{Binding SetupAnWaveCommand}" Margin="0,0,0,0"
                            Visibility="{Binding IsAnWaveInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <Button Content="Auto-Apply" Style="{StaticResource DarkButtonStyle}" Padding="8,3" FontSize="10"
                            Command="{Binding AutoApplyToAnWaveCommand}"
                            Visibility="{Binding IsAnWaveInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content — Version Table -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Installed Versions"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Versions}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      Background="{StaticResource DarkBackgroundBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      RowBackground="{StaticResource DarkBackgroundBrush}"
                      AlternatingRowBackground="{StaticResource SurfaceBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                      RowHeight="30"
                      ColumnHeaderHeight="34">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source" Binding="{Binding DisplaySource}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource NvidiaGreenBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Build ID" Binding="{Binding BuildID}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DLSS" Binding="{Binding DLSS}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Frame Gen" Binding="{Binding FrameGen}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DLSSD" Binding="{Binding DLSSD}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DeepDVC" Binding="{Binding DeepDVC}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Streamline" Binding="{Binding Streamline}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanStatus}" Value="Scanning...">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanStatus}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUpdatingAll}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource NvidiaGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Last: " Foreground="#555555" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding LastScanTime, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Progress during update -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsUpdatingAll, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="6"
                                 Foreground="{StaticResource NvidiaGreenBrush}" Background="{StaticResource DarkBackgroundBrush}"/>
                    <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource NvidiaGreenBrush}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Warning / error message -->
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}"
                           FontSize="10" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>

                <!-- Version status message -->
                <TextBlock Grid.Column="3" Text="{Binding VersionStatusMessage}" Foreground="{StaticResource NvidiaGreenBrush}"
                           FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
